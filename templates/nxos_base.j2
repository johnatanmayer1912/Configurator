!
! ─────────────────────────────────────────────────────────────────────────────
! LOGGING & DEBUGGING
! ─────────────────────────────────────────────────────────────────────────────
! show logging logfile            # Log file contents
! show logging logfile last 100    # Last 100 log entries
! show logging nvram               # NVRAM log contents
! show logging level               # Logging level configuration
! show logging status             # Logging server status
! show logging last 50             # Last 50 messages from all facilities
! show debug-filter               # Debug filter status (if debugging enabled)
! show processes                   # All running processes
! show processes cpu               # CPU utilization by process
! show processes memory            # Memory utilization by process
! show system internal mts buffer summary  # Message transport buffer status
!
! ─────────────────────────────────────────────────────────────────────────────
! PERFORMANCE MONITORING
! ─────────────────────────────────────────────────────────────────────────────
! show system resources           # CPU, memory, buffer utilization
! show hardware internal forwarding l2 detail  # L2 forwarding details
! show hardware internal forwarding l3 detail  # L3 forwarding details
! show interface hardware queue    # Hardware queue statistics
! show queueing                   # Queueing configuration and statistics
! show policy-map interface <interface>  # QoS policy application
! show class-map                   # QoS class-map configuration
! show policy-map                  # QoS policy-map configuration
! show netflow                     # NetFlow statistics (if enabled)
! show sampler                     # NetFlow sampler configuration
!
! ─────────────────────────────────────────────────────────────────────────────
! STORAGE & FILE SYSTEM
! ─────────────────────────────────────────────────────────────────────────────
! dir bootflash:                   # List bootflash contents
! dir logflash:                    # List logflash contents (if present)
! show system internal flash       # Flash memory status
! show system internal kernel uptime  # Kernel uptime (also in system section)
! show version | include uptime     # System uptime
!
! ─────────────────────────────────────────────────────────────────────────────
! CONFIGURATION MANAGEMENT
! ─────────────────────────────────────────────────────────────────────────────
! show running-config              # Current running configuration
! show startup-config              # Startup configuration (saved)
! show diff rollback-config       # Differences between running and startup
! show running-config diff startup-config  # Same as above
! show running-config section <section>  # Specific configuration section
! show running-config | include <pattern>  # Filter configuration
! show running-config | begin <pattern>   # Start from pattern
! copy running-config startup-config  # Save configuration
! write memory                    # Same as above (short form)
!
! ─────────────────────────────────────────────────────────────────────────────
! TROUBLESHOOTING WORKFLOOS
! ─────────────────────────────────────────────────────────────────────────────
!
! WORKFLOW: Interface Not Coming Up
! 1) show interface status          # Check interface state
! 2) show interface counters        # Check for errors
! 3) show spanning-tree interface <intf>  # Check STP blocking
! 4) show lacp counters             # Check LACP if port-channel
! 5) show logging logfile last 50    # Check for error messages
!
! WORKFLOW: vPC Peer-Link Down
! 1) show vpc peer-link             # Check peer-link status
